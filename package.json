{
  "name": "dsh-memory",
  "version": "0.2.0",
  "description": "DSH 持久化记忆插件：用户画像 + 记忆抽取队列 + 基线注入/回合召回 + 记忆/画像管理 Web 页。",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsdown"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    }
  },
  "devDependencies": {
    "tsdown": "*",
    "typescript": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["memory"],
      "external": ["react"],
      "immediately": false
    }
  }
}